    {
      "id": 14,
      "type": "stat",
      "title": "Embeddings saved (range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Share of chunks whose embedding was reused instead of recomputed.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(indexer_chunks_reused_total[$__range])) / clamp_min(sum(increase(indexer_chunks_reused_total[$__range])) + sum(increase(indexer_chunks_embedded_total[$__range])), 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
